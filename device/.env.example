# HERA device configuration.
#
# Copy to .env and adjust. Every value below is the built-in default, so an
# empty .env is a valid configuration. Each variable can also be set in the
# environment, which takes precedence over .env. Section references are to
# PROTOCOL.md.

# --- network (§2) ---
# Mode used until a client selects one over BLE (NET_CFG) or with
# CMD NET_MODE; the client's choice is persisted in /var/lib/hera/net_mode and
# takes precedence. After three starts within five minutes that do not bring
# the network up, the device starts in AP mode regardless (§2.5).
#
# ap   The device is the WiFi access point (default, §2.1).
# sta  The device joins an existing WiFi network. Intended for bench use: the
#      control port is reachable from the whole network and the phone's
#      default route is not changed (§2.2). Traffic is encrypted in both modes.
# none Development mode. The network configuration is left untouched: no
#      hostapd, no wpa_supplicant, no NetworkManager handover, no address
#      changes. The service listens on the address the interface already has.
#      Useful because the Pi has a single radio and AP mode drops an SSH
#      session over WiFi. Clients see the device as `sta`; network changes
#      requested over NET_CFG are refused, and no AP passphrase is delivered.
#
# The serial transport (`usb`, §2.3) is not implemented by this device.
HERA_NET_MODE=ap
HERA_CTRL_PORT=7420
HERA_AUDIO_PORT=7421
HERA_WIFI_IFACE=wlan0

# The SSID is <prefix>-XXXX, where XXXX are the last two bytes of the WiFi MAC
# address in hexadecimal.
HERA_AP_SSID_PREFIX=HERA
HERA_AP_CHANNEL=6
# Regulatory domain, ISO 3166-1 alpha-2. Required: without it the kernel uses
# the world domain "00", where 2.4 GHz channels are no-IR and the access point
# cannot send beacons. hostapd keeps running but the network is not visible.
HERA_WIFI_COUNTRY=IT
HERA_AP_ADDR=192.168.73.1/24

# Hotspot passphrase. When empty, a passphrase is generated on first start,
# stored in HERA_AP_PASS_FILE and delivered over BLE (§3.4).
#
# A fixed value is useful during bring-up, to join the hotspot from a laptop
# without BLE. It must be 8-63 printable ASCII characters without `"` or `\`;
# an invalid value is logged and ignored.
HERA_AP_PASSPHRASE=

# Station-mode credentials (HERA_NET_MODE=sta). Normally provisioned over BLE
# (NET_CFG, §3.3) and stored in /var/lib/hera/station; stored credentials take
# precedence over these. NET_CFG FORGET_STA deletes the stored credentials.
# The source in use is logged at start-up.
HERA_STA_SSID=
HERA_STA_PSK=

# Fall back to AP mode if no address is obtained within this time (§2.5).
HERA_STA_TIMEOUT_S=30

# --- session (§5) ---
# How long a dropped session is kept, with the call up, waiting for the client
# to resume it (§5.4).
HERA_RESUME_WINDOW_S=10
# Time without any frame from the client after which it is considered gone
# (§5.5).
HERA_PEER_TIMEOUT_S=5
# Action when the resume window expires with a call up or ringing:
# `silence` keeps the call up, `hangup` ends it.
HERA_ON_ORPHAN=silence

# --- audio (§6) ---
# `auto` selects the format as described in §6.2. Other values force a format,
# if the client offers it: pcm16_8k, pcm16_16k, g711a, g711u.
HERA_FMT=auto

# Audio block duration in ms. 0 selects the shortest duration offered by the
# client; 20, 10 or 5 forces that duration if the client offers it.
#
# Shorter blocks reduce latency (§7) at the cost of more packets per second:
# 50, 100 or 200 per direction. On a combo WiFi/Bluetooth chip this should be
# measured with a call active (§1.2).
HERA_FRAME_MS=0

# Uplink jitter buffer (§6.5). The target depth adapts to measured jitter
# between these two bounds. The ceiling is also the depth at which the oldest
# block is dropped (ul_late). The floor is limited to half the ceiling and is
# never below one block. STATS reports the current target as ul_target_ms
# (§10.1).
HERA_JITTER_PREFILL_MS=20
HERA_JITTER_MAX_MS=100

# --- security (§11) ---
# 16-byte session token, generated on first start (§11.4). It is delivered
# over BLE and never sent over IP.
HERA_TOKEN_FILE=/var/lib/hera/token
# Where the generated hotspot passphrase is stored. It is kept across restarts
# because phones store the network; HERA_AP_PASSPHRASE overrides it.
HERA_AP_PASS_FILE=/var/lib/hera/ap_passphrase
#
# There is no pairing window. SESSION can be read whenever no session is
# established or resumable (§3.4).

# --- audio engine ---
# SCHED_FIFO priority of the SCO thread. 0 keeps normal scheduling, which on a
# single-core Pi Zero W causes dropouts under load.
HERA_AUDIO_RT_PRIO=20
# Silent SCO packets queued at the start of the audio stream. Each adds about
# 3.75 ms of permanent latency towards the phone (§7.1). Raise only if audio
# gaps are heard at the start of a call.
HERA_SCO_PRIME_PKTS=0

# --- HFP ---
# Reconnect to the last phone at start-up and whenever the link drops:
# HERA_RECONNECT_ATTEMPTS attempts every HERA_RECONNECT_INTERVAL seconds, then
# one attempt per minute until the phone is back.
HERA_AUTO_RECONNECT=true
HERA_RECONNECT_ATTEMPTS=12
HERA_RECONNECT_INTERVAL=5
# Answer incoming calls without waiting for CMD ANSWER. Normally the client
# decides.
HERA_AUTO_ANSWER=false
HERA_AUTO_ANSWER_DELAY_MS=0
HERA_LAST_DEVICE_FILE=last_device

# --- BLE (§3) ---
# Name advertised over BLE and set as the Bluetooth adapter alias.
HERA_BT_ALIAS=HERA

# --- misc ---
# stderr verbosity: 0 off, 1 errors, 2 info, 3 debug (same scale as
# CMD LOG_LEVEL). LOG frames sent to the client are controlled separately by
# CMD LOG_LEVEL and default to 1.
HERA_LOG_LEVEL=2

# --- D-Bus object paths (rarely changed) ---
HERA_AGENT_PATH=/org/hera/agent
HERA_PROFILE_PATH=/org/hera/hfp
HERA_GATT_PATH=/org/hera/gatt
HERA_ADV_PATH=/org/hera/adv
